{
  "name": "amuse",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@10.26.1",
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/*\" run dev",
    "build": "pnpm --filter \"./apps/*\" run build",
    "start": "pnpm --filter @amuse/server run start",
    "typecheck": "tsc --build && pnpm --filter \"./apps/*\" run typecheck",
    "db:generate": "pnpm --filter @amuse/db run generate",
    "setup:browser": "playwright-core install chromium",
    "test:e2e": "node tests/e2e/happy-path.mjs",
    "test": "pnpm --filter @amuse/server test",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "playwright-core": "^1.65.0",
    "prettier": "^3.9.10",
    "typescript": "~5.9.3"
  }
}
